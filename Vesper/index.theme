[Icon Theme]
Name=Vesper
Comment=Firefly-inspired icon theme with purple gradients and a warm glow
Inherits=hicolor
Example=folder

Directories=apps/scalable,apps/symbolic,places/scalable,mimes/scalable,status/symbolic,devices/scalable

[apps/scalable]
Size=128
Context=Applications
Type=Scalable
MinSize=1
MaxSize=512

[apps/symbolic]
Size=16
Context=Applications
Type=Fixed

[places/scalable]
Size=128
Context=Places
Type=Scalable
MinSize=1
MaxSize=512

[mimes/scalable]
Size=128
Context=MimeTypes
Type=Scalable
MinSize=1
MaxSize=512

[status/symbolic]
Size=16
Context=Status
Type=Fixed

[devices/scalable]
Size=128
Context=Devices
Type=Scalable
MinSize=1
MaxSize=512
